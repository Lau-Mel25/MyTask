# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo ".env" NO se sube a GitHub.

# Clave de Gemini: se obtiene gratis en https://aistudio.google.com (Get API key)
GEMINI_API_KEY=pega-aqui-tu-clave-de-gemini

# Opcional: modelo de Gemini. Si lo dejas vacío usa el que trae el código.
GEMINI_MODEL=

# Clave compartida entre Django y el microservicio (inventa una larga)
INTERNAL_API_KEY=cambia-esta-clave-interna

# Clave secreta de Django (inventa una larga)
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-de-django

# Administrador que se crea solo al arrancar (así no necesitas una consola).
# Si ya existe, no pasa nada. Cambia la contraseña por una tuya.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
DJANGO_SUPERUSER_EMAIL=admin@example.com

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
